# ---- Server ----
NODE_ENV=development
# Dedicated port (avoids colliding with the other ONDC apps on 3000/4000).
PORT=4090
LOG_LEVEL=info
# Comma-separated allowed origins for the dashboard frontend
CORS_ORIGIN=http://localhost:5190

# Optional shared admin token. If set, all /api routes require
# `Authorization: Bearer <token>`. Leave empty to disable (internal-only).
# /api/auth/login hands this token to the client on successful login.
ADMIN_TOKEN=

# ---- Dashboard login ----
# Validated server-side by /api/auth/login. Credentials never reach the
# browser bundle. Set ADMIN_TOKEN above too so the API itself is protected.
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me

# ---- Redis (same instance the mock service uses) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# DB0 = business/workbench state, DB1 = mock-runner config cache
REDIS_DB_0=0
REDIS_DB_1=1
# Hard cap on keys returned per /api/redis/scan page
REDIS_SCAN_PAGE_SIZE=200

# ---- Observability upstreams ----
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3005
# Service token used when proxying to Grafana's HTTP API (optional)
GRAFANA_API_TOKEN=
# Basic-auth fallback used when no token is set (Grafana default: admin/admin)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# The monitored service's health endpoint (aggregated into /api/health).
# NOTE: the service exposes health at the TOP-LEVEL /health (not under
# /mock/playground). Point this at wherever the service actually runs.
SERVICE_HEALTH_URL=http://localhost:3000/health

# =============================================================================
# MCP section — the incident corpus and triage loop for `automation-mcp`
# (the mock ONDC network participant).
#
# "MCP" here is the name of the section, not a protocol: this service does not
# speak the Model Context Protocol and serves no MCP endpoint.
# =============================================================================
#
# MONGO_URL unset is the section's ONLY off switch, and unset is the default.
# With it unset this backend behaves exactly as it did before the section
# existed: the dashboard boots, every page above keeps working, /api/mcp/*
# answers 503 and the frontend hides the "MCP Corpus" nav group.
#
#   docker compose -f docker-compose.dev.yml up -d      # mongo on :27017

# MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=automation_mcp_dashboard
# Journal lines are the bulky, least individually valuable documents, and the
# only thing here with a TTL.
TELEMETRY_RETENTION_DAYS=30

# ---- Ingest: what the engine POSTs to ---------------------------------------
# Set the SAME value as FEEDBACK_API_KEY / MIRROR_API_KEY on the engine.
# Required when NODE_ENV=production AND MONGO_URL is set — the ingest is a
# public write surface into the corpus that decides what gets fixed.
INGEST_API_KEY=
INGEST_BODY_LIMIT_BYTES=2000000
#
# On the engine (automation-mcp/.env), point it back here:
#   FEEDBACK_ENDPOINT_URL=http://127.0.0.1:4090/ingest/reports
#   MIRROR_ENDPOINT_URL=http://127.0.0.1:4090/ingest/telemetry
#   FEEDBACK_API_KEY=<the value above>
#   MIRROR_API_KEY=<the value above>
#   TELEMETRY_CORRELATION=true   # deep-link a report to the run that caused it
#   FEEDBACK_SALT=<any stable string>
#
# FEEDBACK_SALT matters more than it looks: unset, the engine generates one per
# process, so install_id changes on every restart and one operator looks like
# many.
#
# NOTE the /ingest path is NOT behind ADMIN_TOKEN — it carries its own bearer.
# If you put this service behind an ingress that rewrites paths, check it is
# still reachable: a 404 reaching the engine's spool is a PERMANENT refusal and
# destroys the report.

# ---- Triage ------------------------------------------------------------------
# Nothing to configure. Status, notes, fix links and dismissals are authored in
# the dashboard and stored on the incident document in Mongo. There is no issue
# tracker and nothing is filed anywhere, so this service makes no outbound calls
# on your behalf.

# ---- This service's own Prometheus exposition -------------------------------
# Served at /mcp-metrics, NOT /metrics — the latter would read as a sibling of
# the /api/metrics/* PROXY above, which queries Prometheus rather than being
# scraped by it. Off by default; this dashboard has never exported its own.
# METRICS_TOKEN is required when NODE_ENV=production and this is on.
METRICS_ENABLED=false
METRICS_TOKEN=
